{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "color": {
      "palette": [
        { "slug": "charcoal", "name": "Charcoal", "color": "#18140F" },
        { "slug": "charcoal-soft", "name": "Charcoal Soft", "color": "#3A332B" },
        { "slug": "cream", "name": "Cream", "color": "#F4EFE6" },
        { "slug": "cream-deep", "name": "Cream Deep", "color": "#EDE5D2" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" },
        { "slug": "lime", "name": "Lime Green", "color": "#C0DA6B" },
        { "slug": "magenta", "name": "Magenta", "color": "#D6266F" },
        { "slug": "gold", "name": "Orange Gold", "color": "#E8A33D" },
        { "slug": "cyan", "name": "Cyan", "color": "#38B6D9" },
        { "slug": "muted", "name": "Muted", "color": "#8B8275" }
      ],
      "duotone": [],
      "gradients": [],
      "custom": false,
      "customDuotone": false,
      "customGradient": false
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "primary",
          "name": "Source Sans Pro",
          "fontFamily": "'Source Sans Pro', Georgia, Arial, sans-serif"
        },
        {
          "slug": "fallback",
          "name": "Georgia / Arial",
          "fontFamily": "Georgia, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "14px" },
        { "slug": "medium", "name": "Medium", "size": "18px" },
        { "slug": "large", "name": "Large", "size": "28px" },
        { "slug": "x-large", "name": "Extra Large", "size": "48px" },
        { "slug": "xx-large", "name": "XX Large", "size": "80px" }
      ],
      "customFontSize": true,
      "lineHeight": true
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [ "px", "em", "rem", "%", "vh", "vw" ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream)",
      "text": "var(--wp--preset--color--charcoal)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary), Georgia, Arial, sans-serif",
      "fontSize": "16px",
      "lineHeight": "1.5"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--charcoal)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--gold)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary), Georgia, Arial, sans-serif",
          "fontWeight": "700",
          "letterSpacing": "-0.02em"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--gold)",
          "text": "var(--wp--preset--color--charcoal)"
        },
        "border": {
          "radius": "999px"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--charcoal)",
            "text": "var(--wp--preset--color--cream)"
          }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
